{
  // 部署前需先创建真实资源并替换占位 ID（TECH_DESIGN §9.4 部署清单）：
  //   npx wrangler d1 create whl-auth        -> DB.database_id
  //   npx wrangler secret put COOKIE_DOMAIN  -> ".whleague.win"
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whl-auth",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whl-auth",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
    // 步骤③账号收口（P0-11）后 auth 不再绑定 tour 账号库；TOUR_DB 过渡绑定已移除（TECH_DESIGN §5.3）
  ],
  "kv_namespaces": [
    // 共享会话 KV：与 tour/guess 同一 namespace，写 sess:* 兼容键（兼容桥，步骤③收口后移除）
    {
      "binding": "SESSION_KV",
      "id": "87e2d78308bc47e9b36dc6de53be0458"
    }
    // 限流不再走 KV（TEST_REPORT F-E/F-B）：计数落 D1 的 rate_limit 表，RL_KV 绑定与建号步骤一并移除
  ],
  // 每日清理 rate_limit 表里过期的窗口行（src/index.ts 的 scheduled）
  "triggers": {
    "crons": ["23 4 * * *"]
  },
  "observability": {
    "enabled": true
  },
  // 与 tour 一致：让计算靠近 D1（亚太）数据中心
  "placement": {
    "mode": "smart"
  }
}
